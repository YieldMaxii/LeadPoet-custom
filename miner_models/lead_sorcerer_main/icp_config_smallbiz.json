    "max_results_per_query": 30
  },
  "testing": {
    "process_rejected": false,
    "process_low_crawl": false,
    "force_contact_discovery": true
  },
  "caps": {
    "company_usd": 0.03,
    "contact_usd": 0.04,
    "run_usd_max": 10.0,
    "max_domains_per_run": 50,
    "max_crawl_per_run": 50,
    "max_enrich_per_run": 50
  },
  "role_priority": {
    "owner": 1,
    "founder": 1,
    "co-founder": 1,
    "ceo": 1,
    "chief executive officer": 1,
    "president": 1,
    "principal": 1,
    "managing director": 1,
    "managing partner": 1,
    "partner": 2,
    "director": 2,
    "vp": 2,
    "vice president": 2,
    "head of": 2,
    "account director": 3,
    "creative director": 3,
    "default": 99
  },
  "exports": {
