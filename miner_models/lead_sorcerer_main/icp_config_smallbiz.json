      "solutions",
      "strategies",
      "advisors",
      "collective"
    ]
  },
  "threshold": 0.5,
  "filtering_strict": false,
  "mode": "fast",
  "refresh_policy": {
    "revisit_after_days": 90,
    "failure_revisit_days": 7,
