{
  "name": "Small Business Services - Owner Contacts",
  "icp_text": "Small service-based businesses (marketing agencies, consulting firms, creative studios) with 2-25 employees that list owner and team contact information on their websites. Focus on businesses that actively want to be contacted for new client inquiries.",
  "queries": [
    "marketing agency owner email contact us",
    "digital marketing agency founder contact",
    "small consulting firm owner email",
    "creative agency team page contact",
    "web design agency owner email",
    "SEO agency founder contact information",
    "branding agency owner email address",
    "social media agency contact founder",
    "content marketing agency owner email",
    "small PR agency founder contact",
    "business consultant contact email",
    "management consulting firm owner email",
    "strategy consultant founder contact",
    "growth consultant owner email",
    "fractional CMO contact email",
    "marketing consultant founder email",
    "small advertising agency owner contact",
    "boutique agency founder email",
    "independent consultant contact email",
    "freelance agency owner email contact"
  ],
  "specific_urls": [],
  "default_contact_linkedin": "",
  "required_fields": {
    "company": ["name", "industry", "sub_industry"],
    "contact": ["email", "job_title", "full_name"]
  },
  "optional_fields": {
    "company": ["hq_location", "revenue_range", "employee_count", "specialties", "founded_year", "company_type", "number_of_locations", "ownership_type"],
    "contact": ["phone", "linkedin_url", "decision_maker", "department", "seniority"]
  },
  "validation_config": {
    "industry_keywords": [
      "marketing",
      "advertising",
      "digital",
      "creative",
      "agency",
      "consulting",
      "consultant",
      "branding",
      "design",
